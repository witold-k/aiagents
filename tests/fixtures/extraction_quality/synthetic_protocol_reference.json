          "parameter": "interval",
          "minimum": 0,
          "maximum": 60
        }
      ]
    },
    {
      "id": "q",
      "direction": "device_to_controller",
      "source_section": "Responses",
      "source_excerpt": "Report readiness and optionally include diagnostic code.",
      "parameters": [
        {
          "position": 1,
          "name": "ready",
          "type": "bool",
          "required": true
        },
        {
          "position": 2,
          "name": "diagnostic_code",
          "type": "int",
          "required": false
        }
      ],
      "constraints": [
        {
          "kind": "conditional",
          "parameter": "diagnostic_code",
          "when": "ready is false"
        }
