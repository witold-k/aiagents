  "messages": [
    {
      "id": "P",
      "direction": "controller_to_device",
      "source_section": "Definitions",
      "source_excerpt": "Set sample interval and optional retry count.",
      "parameters": [
        {
          "position": 1,
          "name": "interval",
          "type": "int",
          "unit": "seconds",
