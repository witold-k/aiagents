current_dir      := justfile_directory()
target_dir       := current_dir / 'build'

default: build

config: clean
    cmake -S {{current_dir}} -B {{target_dir}} -G Ninja

build: config
    cmake --build {{target_dir}}

fix: config
    git -C {{current_dir}} restore --worktree -- .
    aifix {{env_var_or_default("AIFIX_TEST_ARGS", "")}} -l cpp -t fix_code -f {{current_dir}} -f {{current_dir}}/..

fixd: config
    git -C {{current_dir}} restore --worktree -- .
    aifix {{env_var_or_default("AIFIX_TEST_ARGS", "")}} -d -l cpp -t fix_code -f {{current_dir}} -f {{current_dir}}/..

fixws: config
    git -C {{current_dir}} restore --worktree -- .
    aifix {{env_var_or_default("AIFIX_TEST_ARGS", "")}} -l cpp -t fix_code -w ~/svn/_workspace -f {{current_dir}} -f {{current_dir}}/.. -f ~/svn/_workspace

doc:
    git -C {{current_dir}} restore --worktree -- .
    aifix {{env_var_or_default("AIFIX_TEST_ARGS", "")}} -l cpp -t write_doc -w ~/svn/_workspace -f {{current_dir}} -f {{current_dir}}/..

fixfail: config
    git -C {{current_dir}} restore --worktree -- .
    aifix {{env_var_or_default("AIFIX_TEST_ARGS", "")}} -l cpp -t fix_code -f {{current_dir}}/target -f {{current_dir}}/..

clean:
    rm -rf {{target_dir}}

