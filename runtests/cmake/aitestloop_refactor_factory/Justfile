current_dir := justfile_directory()
target_dir := current_dir / 'build'
default: build
config:
    cmake -S {{current_dir}} -B {{target_dir}} -G Ninja
build: config
    cmake --build {{target_dir}}
    ctest --test-dir {{target_dir}} --output-on-failure
fix:
    git -C {{current_dir}} restore --worktree -- .
    just config
    aifix -l cpp -t fix_code -m "Keep the Dummy constructor private and the factory API unchanged. Fix the outdated tests to call the factory, handle the optional result, and verify both successful and failed creation." -b {{target_dir}} -f {{current_dir}} -f {{current_dir}}/..
fixd:
    git -C {{current_dir}} restore --worktree -- .
    just config
    aifix -d -l cpp -t fix_code -m "Keep the Dummy constructor private and the factory API unchanged. Fix the outdated tests to call the factory, handle the optional result, and verify both successful and failed creation." -b {{target_dir}} -f {{current_dir}} -f {{current_dir}}/..
clean:
    rm -rf {{target_dir}}
