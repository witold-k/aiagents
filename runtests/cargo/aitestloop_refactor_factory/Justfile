current_dir := justfile_directory()
default: build
build:
    cargo build
    cargo test
    cargo clippy
fix:
    git -C {{current_dir}} restore --worktree -- .
    aifix {{env_var_or_default("AIFIX_TEST_ARGS", "")}} -l rust -t fix_code -m "Keep the Dummy constructor private and the factory API unchanged. Fix the outdated tests to call the factory, handle the optional result, and verify both successful and failed creation." -f {{current_dir}} -f {{current_dir}}/..
fixd:
    git -C {{current_dir}} restore --worktree -- .
    aifix {{env_var_or_default("AIFIX_TEST_ARGS", "")}} -d -l rust -t fix_code -m "Keep the Dummy constructor private and the factory API unchanged. Fix the outdated tests to call the factory, handle the optional result, and verify both successful and failed creation." -f {{current_dir}} -f {{current_dir}}/..
clean:
    cargo clean
