current_dir := justfile_directory()
default: build
build:
    mvn test
fix:
    git checkout -- .
    aifix -l java -t fix_code -m "Keep the Dummy constructor private and the factory API unchanged. Fix the outdated tests to call the factory, handle the optional result, and verify both successful and failed creation." -f {{current_dir}} -f {{current_dir}}/..
fixd:
    git checkout -- .
    aifix -d -l java -t fix_code -m "Keep the Dummy constructor private and the factory API unchanged. Fix the outdated tests to call the factory, handle the optional result, and verify both successful and failed creation." -f {{current_dir}} -f {{current_dir}}/..
clean:
    mvn clean
